BN_ENVIRONMENT=development
BN_API_HOST=0.0.0.0
BN_API_PORT=8080
BN_APP_SECRET=replace-with-at-least-32-random-characters
BN_LOOKUP_PEPPER=replace-with-a-separate-stable-lookup-pepper
BN_PII_FERNET_KEY=
BN_DATABASE_URL=postgresql+asyncpg://bureau:bureau@postgres:5432/bureau
BN_REDIS_URL=redis://redis:6379/0
BN_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# S3 API. Работает с Yandex Object Storage, MinIO и AWS S3.
BN_S3_ENDPOINT=http://minio:9000
BN_S3_REGION=ru-central1
BN_S3_BUCKET=bureau-media
BN_S3_ACCESS_KEY=bureau
BN_S3_SECRET_KEY=replace-this-minio-password
BN_S3_PUBLIC_ENDPOINT=http://localhost:9000
BN_S3_PRESIGN_TTL_SECONDS=900

# OpenAI Responses API. Без ключа используется безопасный локальный fallback.
BN_OPENAI_API_KEY=
BN_OPENAI_API_KEY_FILE=
BN_OPENAI_MODEL=gpt-5.6

# Отдельный OpenCLIP HTTP-сервис; можно оставить пустым на старте.
BN_OPENCLIP_URL=http://openclip:8090
BN_OPENCLIP_TIMEOUT_SECONDS=20

# SMS-провайдер. Если URL пустой, в development код возвращается в API.
BN_SMS_PROVIDER_URL=
BN_SMS_PROVIDER_TOKEN=
BN_BOOTSTRAP_ADMIN_PHONE=+79990000000
BN_LOG_LEVEL=INFO
BN_PUBLIC_API_URL=http://localhost:8080/v1
BN_SUPPORT_EMAIL=support@bureau.local
BN_MIN_IOS_VERSION=1.0.0
BN_MIN_ANDROID_VERSION=1.0.0
BN_ADMIN_2FA_ISSUER=Бюро находок
BN_WEBHOOK_TIMEOUT_SECONDS=10
BN_WEBHOOK_MAX_ATTEMPTS=6
