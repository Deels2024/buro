# Адрес, по которому пользователи открывают систему.
PUBLIC_BASE_URL=http://localhost
S3_PUBLIC_URL=http://localhost:9000
HTTP_PORT=80
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# install.sh автоматически заменит эти значения безопасными случайными ключами.
BN_APP_SECRET=__APP_SECRET__
BN_LOOKUP_PEPPER=__LOOKUP_PEPPER__
BN_PII_FERNET_KEY=__PII_FERNET_KEY__
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
MINIO_PASSWORD=__MINIO_PASSWORD__

# Первый администратор. В development SMS-код показывается прямо на экране входа.
BN_BOOTSTRAP_ADMIN_PHONE=+79990000000
BN_ENVIRONMENT=development
ADMIN_COOKIE_SECURE=false

# Внешние сервисы можно подключить после первого запуска.
BN_OPENAI_API_KEY=
BN_OPENAI_MODEL=gpt-5.6
BN_SMS_PROVIDER_URL=
BN_SMS_PROVIDER_TOKEN=
BN_SUPPORT_EMAIL=support@bureau.local
