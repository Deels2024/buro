FROM alpine:3.20 AS release
RUN apk add --no-cache curl
COPY .git/ /git/
COPY scripts/read-release-sha.sh scripts/fetch-web-release.sh /scripts/
ARG BUREAU_RELEASE_BASE_URL=https://github.com/Deels2024/buro/releases/download
RUN test ! -e /git/config && test ! -d /git/objects && \
    release="$(sh /scripts/read-release-sha.sh /git)" && \
    BUREAU_RELEASE_BASE_URL="$BUREAU_RELEASE_BASE_URL" sh /scripts/fetch-web-release.sh "$release" /web

FROM nginx:1.27-alpine AS runner
COPY flutter/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=release /web /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=5s --retries=20 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
