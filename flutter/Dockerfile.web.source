FROM ghcr.io/cirruslabs/flutter:stable AS builder

WORKDIR /app
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get

COPY . .
ARG BUREAU_PUBLIC_API_URL=https://edinburo.ru/v1
RUN flutter build web \
    --release --base-href=/app/ \
    --dart-define=BUREAU_API_URL="${BUREAU_PUBLIC_API_URL}" && \
    mkdir -p build/web/icons && \
    cp web/robots.txt web/sitemap.xml web/site.webmanifest web/favicon.svg web/og-image.png build/web/ && \
    cp web/icons/icon-180.png web/icons/icon-192.png web/icons/icon-512.png build/web/icons/

FROM nginx:1.27-alpine AS runner
COPY nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/build/web /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=5s --retries=20 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
